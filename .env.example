# Copy to .env. Every project runs without any of these when LLM_PROVIDER=mock.

# --- provider ---------------------------------------------------------------
# `mock` replays recorded cassettes: offline, deterministic, free. This is the
# default for tests and `make smoke`. Unset it to make real calls.
LLM_PROVIDER=mock

# Required for real calls (P1-P11).
ANTHROPIC_API_KEY=

# Model defaults. See core/agentcore/models.py for the registry.
AGENT_MODEL=claude-opus-5
# low | medium | high | xhigh | max  (ignored on Haiku 4.5, which has no effort)
AGENT_EFFORT=

# --- optional ---------------------------------------------------------------
# Embeddings for P2 (RAG) and P5 (memory). Without it, both fall back to the
# deterministic hash embedder — retrieval mechanics work, semantics do not.
VOYAGE_API_KEY=

# Web-search fallback for P2. Without it, P2 refuses below its confidence
# threshold instead of falling back — which is still correct behaviour.
TAVILY_API_KEY=

# Optional trace export for P11. Local JSONL tracing works without it.
LANGSMITH_API_KEY=

# --- paths ------------------------------------------------------------------
AGENTCORE_DB=agentcore.db
AGENTCORE_TRACE_FILE=traces.jsonl

# Set to 1 alongside a real key to record cassettes into core/fixtures/.
AGENTCORE_RECORD=0
